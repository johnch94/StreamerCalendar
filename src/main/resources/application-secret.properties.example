# 이 파일을 복사해 같은 폴더에 application-secret.properties로 저장한 뒤 실제 값을 입력하세요.
# application-secret.properties는 .gitignore 대상이라 커밋되지 않습니다.
spring.datasource.url=jdbc:postgresql://localhost:5432/stream_cal
spring.datasource.username=
spring.datasource.password=

# 관리자 계정 (스트리머/방송 기록 등록·수정·삭제 권한). 비어 있으면 서버가 뜨지 않습니다.
# password에는 평문이 아니라 {bcrypt} 접두사를 붙인 BCrypt 해시를 넣습니다.
# 해시 만들기: ./gradlew hashPassword -Ppassword=원하는비밀번호  → 출력된 {bcrypt}... 값을 그대로 붙여넣기
# (환경변수 APP_ADMIN_USERNAME / APP_ADMIN_PASSWORD / APP_ADMIN_REMEMBER_ME_KEY가 있으면 그 값이 우선 적용됨)
app.admin.username=admin
app.admin.password=
# "로그인 상태 유지" 쿠키 서명용 비밀 키 (아무도 모르는 긴 임의 문자열). 바꾸면 기존 로그인 유지 쿠키가 모두 풀립니다.
# 만들기 예) openssl rand -base64 32   (환경변수 APP_ADMIN_REMEMBER_ME_KEY로도 지정 가능)
app.admin.remember-me-key=
